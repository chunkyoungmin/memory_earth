# 서버 포트
PORT=4000

# 관리자 권한을 부여할 기존 users.id 목록 (쉼표로 구분, 비워두면 관리자 없음)
ADMIN_USER_IDS=

# 프론트엔드 Origin (CORS 허용) - 개발/운영 분리
# 개발: http://localhost:5173
# 운영: https://earth-memory-client.onrender.com
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=earth_memory
DB_USER=earth_memory_app
DB_PASSWORD=changeme

# 업로드 파일 저장 경로 (초기: 로컬 디스크, 추후: OCI Object Storage)
UPLOAD_DIR=../uploads
